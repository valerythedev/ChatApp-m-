# Production (Vercel): set in the dashboard before build — Vite inlines these at build time.
# VITE_API_URL=https://your-render-backend.onrender.com
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Local dev — API must match chat-backend PORT; backend FRONTEND_ORIGIN must allow this Vite URL.
VITE_API_URL=http://localhost:5550

# Optional legacy name (used if VITE_API_URL is unset)
# VITE_API_ORIGIN=http://localhost:5550

# Optional — defaults to the API origin (use if WebSocket is on another host)
# VITE_SOCKET_ORIGIN=http://localhost:5550

VITE_MAX_UPLOAD_MB=10
