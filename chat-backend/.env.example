# DATABASE_URL is injected automatically on Render when linked to managed Postgres.
DATABASE_URL=postgresql://user:password@localhost:5432/chatdb
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=chatdb

JWT_SECRET=change-me-in-production-use-at-least-32-chars

# CORS: comma-separated SPA origins. FRONTEND_URL is what Render uses; FRONTEND_ORIGIN is fine for local dev.
FRONTEND_ORIGIN=http://localhost:5173
# FRONTEND_URL=https://your-vercel-app.vercel.app

# Supabase (production file storage — avatars, message media, attachments)
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=

PORT=5550
MAX_UPLOAD_MB=10

# production: set NODE_ENV=production (enforces strong JWT_SECRET and DATABASE_URL checks)
# NODE_ENV=production

# Behind nginx/Traefik/etc.: trust X-Forwarded-* (set to 1 or true)
# TRUST_PROXY=1
# TRUST_PROXY_HOPS=1
